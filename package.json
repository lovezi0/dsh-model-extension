{
  "name": "dsh-model-extension",
  "version": "1.2.3-alpha.2",
  "description": "DeepSeek Harness plugin: the Models+ settings page — a fully plugin-owned model/provider UI with per-model extension fields (reasoning efforts, input modalities, compat flags) and models.dev metadata prefill",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "audit:pi-ai": "node --experimental-strip-types scripts/audit-pi-ai-contract.mjs",
    "audit:compat": "node --experimental-strip-types scripts/audit-compat-protocol.mts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovezi0/dsh-model-extension.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "adapter": "0.1.7-alpha.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "external": [
        "@deepseek-ai/dsh-api-remotes/client",
        "@deepseek-ai/dsh-client-locale/client",
        "@deepseek-ai/dsh-client-ui-settings/client"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-store": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-util-values": "^0.1.7-alpha.1"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "lightningcss": "^1.29.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0",
    "yaml": "^2.9.0"
  }
}
