{
  "name": "dsh-model-extension",
  "version": "1.4.0-alpha.1",
  "description": "DeepSeek Harness plugin: adds catalog quick-load (pi-ai / models.dev) and per-model compat switches to the official Models settings page",
  "type": "module",
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "selftest": "node scripts/selftest.mjs",
    "audit:pi-ai": "node --experimental-strip-types scripts/audit-pi-ai-contract.mjs",
    "audit:compat": "node --experimental-strip-types scripts/audit-compat-protocol.mts",
    "audit:vendor": "node scripts/audit-vendor-drift.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovezi0/dsh-model-extension.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "external": [
        "@deepseek-ai/dsh-api-remotes/client"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "lightningcss": "^1.29.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0",
    "yaml": "^2.9.0"
  }
}
